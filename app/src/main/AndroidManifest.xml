<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Employee Management"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar">

        <activity
            android:name="com.example.thuchanh2.ui.auth.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.thuchanh2.MainActivity"
            android:exported="true" />
        <activity
            android:name="com.example.thuchanh2.ui.admin.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name="com.example.thuchanh2.ui.employee.EmployeeDashboardActivity"
            android:exported="false" />

    </application>
</manifest>
