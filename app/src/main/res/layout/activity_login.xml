<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="HỆ THỐNG QUẢN LÝ GIỜ LÀM &amp; LƯƠNG"
                android:textColor="#1A237E"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="20dp"
                android:gravity="center"
                android:text="Đăng nhập tài khoản Admin hoặc Nhân viên"
                android:textColor="#757575"
                android:textSize="13sp" />

            <!-- Ô nhập Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên đăng nhập (Username / Mã NV):"
                android:textColor="#424242"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtUsername"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="Nhập username (VD: admin hoặc NV01)"
                android:inputType="text"
                android:singleLine="true" />

            <!-- Ô nhập Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Mật khẩu (Password):"
                android:textColor="#424242"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edtPassword"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:hint="Nhập mật khẩu"
                android:inputType="textPassword"
                android:singleLine="true" />

            <!-- Checkbox lưu tài khoản bằng SharedPreferences -->
            <CheckBox
                android:id="@+id/cbRememberMe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:checked="true"
                android:text="Ghi nhớ tài khoản đăng nhập (SharedPreferences)"
                android:textColor="#424242"
                android:textSize="13sp" />

            <!-- Nút Đăng nhập -->
            <Button
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#1A237E"
                android:text="ĐĂNG NHẬP"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Ghi chú tài khoản mặc định hỗ trợ lúc chấm bài -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#E8EAF6"
                android:padding="10dp"
                android:text="• TK Admin mặc định: admin / 123\n• TK Nhân viên: Mã NV (do Admin tạo) / 123"
                android:textColor="#283593"
                android:textSize="12sp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>