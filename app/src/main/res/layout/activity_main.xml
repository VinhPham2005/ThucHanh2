<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MÀN HÌNH TEST"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnAdminMode"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Quản lý nhân viên (Admin)"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnAdminSalary"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Quản lý bảng lương (Admin)"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnEmployeeMode"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Chấm công &amp; Xem lương (Employee)" />

</LinearLayout>
